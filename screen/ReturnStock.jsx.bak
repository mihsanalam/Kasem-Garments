import React, { useState, useEffect } from "react";
import {
  View,
  Text,
  Image,
  StyleSheet,
  FlatList,
  SafeAreaView,
  TouchableOpacity,
  ActivityIndicator,
  TextInput,
} from "react-native";
import { Feather } from "@expo/vector-icons";
import LogoTitle from "@/components/inventory/LogoTitle";
import { router, useFocusEffect } from "expo-router";
import * as SecureStore from "expo-secure-store";
import { mS } from "../style/responsive";
import { returnProductService } from "../service/api/returnProduct";

const PRODUCTS_STORAGE_KEY = "returned_products_data"; // Keep for backward compatibility

const GroupedProductCard = ({ product }) => {
  const { name, quantity, totalAmount } = product; // Remove amount

  return (
    <TouchableOpacity
      style={styles.card}
      onPress={() =>
        router.push({
          pathname: "(tabs)/Home/returnStockTable",
          params: { productName: name },
        })
      }
    >
      <View style={styles.cardContent}>
        <Image
          source={{
            uri: "https://cdn-icons-png.flaticon.com/512/9486/9486994.png",
          }}
          style={styles.icon}
          resizeMode="contain"
        />
        <View style={styles.detailsContainer}>
          <Text style={styles.productName}>{name}</Text>
          <View style={styles.infoRow}>
            <Feather name="shopping-cart" style={styles.infoIcon} />
            <Text style={styles.infoText}>পরিমাণঃ {quantity} টি</Text>
          </View>
          <View style={styles.infoRow}>
            <Feather name="dollar-sign" style={styles.infoIcon} />
            <Text style={styles.infoText}>মোট মূল্যঃ {totalAmount} টাকা</Text>
          </View>
        </View>
      </View>
    </TouchableOpacity>
  );
};

const ReturnProductListScreen = () => {
  const [products, setProducts] = useState([]);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState("");

  useFocusEffect(
    React.useCallback(() => {
      const fetchData = async () => {
        try {
          setLoading(true);

          // Fetch data from Firebase
          const returnedProducts = await returnProductService.getAllReturnedProducts();

          // Also fetch from local storage for backward compatibility
          const storedProductsJson = await SecureStore.getItemAsync(PRODUCTS_STORAGE_KEY);
          const storedProducts = storedProductsJson ? JSON.parse(storedProductsJson) : [];

          // Transform data to match card structure
          let transformedData = [];

          // Process Firebase data
          if (returnedProducts && returnedProducts.length > 0) {
            returnedProducts.forEach((product) => {
              const { items, id } = product;

              if (items && items.length > 0) {
                items.forEach((item, index) => {
                  transformedData.push({
                    id: `firebase-${id}-${index}`,
                    name: item.productName || "Unknown Product",
                    quantity: parseInt(item.quantity || 0),
                    // Use absolute value for display purposes
                    totalAmount: Math.abs(parseFloat(item.price || 0) * parseInt(item.quantity || 0)),
                  });
                });
              }
            });
          }

          // Process local storage data for backward compatibility
          if (storedProducts && storedProducts.length > 0) {
            storedProducts.forEach((product) => {
              const { items, id } = product;

              if (items && items.length > 0) {
                items.forEach((item, index) => {
                  // Create a unique key for local storage items
                  const uniqueKey = `local-${id}-${item.productName}-${item.quantity || item.amount}`;

                  // Only add if we haven't processed this exact entry before
                  if (!processedEntries.has(uniqueKey)) {
                    processedEntries.add(uniqueKey);

                    transformedData.push({
                      id: `local-${id}-${index}`,
                      name: item.productName || "Unknown Product",
                      quantity: parseInt(item.quantity || item.amount || "0"),
                      totalAmount:
                        (parseFloat(item.price) || 0) *
                        parseInt(item.quantity || item.amount || "0"),
                    });
                  }
                });
              }
            });
          }

          // Group products by name and sum quantity and totalAmount
          const groupedProducts = transformedData.reduce((acc, product) => {
            const existingProduct = acc.find((p) => p.name === product.name);

            if (existingProduct) {
              existingProduct.quantity += product.quantity;
              existingProduct.totalAmount += product.totalAmount;
            } else {
              acc.push({
                name: product.name,
                quantity: product.quantity,
                totalAmount: product.totalAmount,
              });
            }
            return acc;
          }, []);

          setProducts(groupedProducts);
        } catch (error) {
          console.error("Error fetching products:", error);
        } finally {
          setLoading(false);
        }
      };
      fetchData();
    }, [])
  );

  const filteredProducts = products.filter((product) =>
    product.name.toLowerCase().includes(searchQuery.toLowerCase())
  );

  return (
    <SafeAreaView style={styles.container}>
      <LogoTitle
        title="ফেরত পণ্যের স্টক"
        otherStyle={{
          marginBottom: mS(20),
          marginTop: mS(20),
          marginLeft: mS(20),
          marginRight: mS(10),
        }}
      />
      <View style={styles.searchContainer}>
        <TextInput
          style={styles.searchInput}
          placeholder="পণ্যের নাম দিয়ে খুঁজুন..."
          value={searchQuery}
          onChangeText={setSearchQuery}
        />
      </View>
      {loading ? (
        <View style={styles.loadingContainer}>
          <ActivityIndicator size="large" color="#4CAF50" />
          <Text style={styles.loadingText}>ডাটা লোড হচ্ছে...</Text>
        </View>
      ) : (
        <FlatList
          data={filteredProducts}
          keyExtractor={(item) => item.name}
          renderItem={({ item }) => <GroupedProductCard product={item} />}
          contentContainerStyle={styles.listContainer}
          ListEmptyComponent={
            <Text style={styles.emptyText}>কোন পণ্য পাওয়া যায়নি</Text>
          }
        />
      )}
    </SafeAreaView>
  );
};

